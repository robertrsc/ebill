# ==============================================================================
# eBill Mini ERP Web - Modelo de Configurações de Ambiente (.env.example)
# Copie este arquivo para ".env" no servidor/ambiente local e preencha com suas credenciais.
# NUNCA inclua senhas reais neste arquivo .env.example.
# ==============================================================================

# Configurações do Banco de Dados MySQL
DB_HOST=localhost
DB_NAME=ebill
DB_USER=root
DB_PASS=suasenhaaqui
DB_CHARSET=utf8mb4

# Configurações da Aplicação
APP_NAME="eBill Soluções ERP"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost

# Configurações de E-mail / SMTP (Opcional - Pode ser definido no .env ou via painel web)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls
MAIL_FROM_ADDRESS=nao-responda@ebill.com.br
MAIL_FROM_NAME="eBill ERP System"
